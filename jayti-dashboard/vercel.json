{
    "framework":  null,
    "outputDirectory":  ".",
    "cleanUrls":  true,
    "headers":  [
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "X-Robots-Tag",
                                            "value":  "noindex, nofollow"
                                        },
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-store"
                                        }
                                    ]
                    }
                ],
    "rewrites":  [
                     {
                         "source":  "/api/stats",
                         "destination":  "/api/stats.js"
                     },
                     {
                         "source":  "/api/visitor",
                         "destination":  "/api/visitor.js"
                     },
                     {
                         "source":  "/api/jp-stats",
                         "destination":  "/api/jp-stats.js"
                     },
                     {
                         "source":  "/api/jp-visitor",
                         "destination":  "/api/jp-visitor.js"
                     },
                     {
                         "source":  "/api/jp-track",
                         "destination":  "/api/jp-track.js"
                     },
                     {
                         "source":  "/api/jp-device",
                         "destination":  "/api/jp-device.js"
                     },
                     {
                         "source":  "/api/jp-agent",
                         "destination":  "/api/jp-agent.js"
                     },
                     {
                         "source":  "/api/jp-ask",
                         "destination":  "/api/jp-ask.js"
                     },
                     {
                         "source":  "/api/jp-devices",
                         "destination":  "/api/jp-devices.js"
                     },
                     {
                         "source":  "/api/check-stale",
                         "destination":  "/api/check-stale.js"
                     },
                     {
                         "source":  "/api/connect",
                         "destination":  "/api/connect.js"
                     },
                     {
                         "source":  "/api/device-command-claim",
                         "destination":  "/api/broker-command-claim"
                     },
                     {
                         "source":  "/api/device-command-claim/:commandId",
                         "destination":  "/api/broker-command-claim"
                     },
                     {
                         "source":  "/api/device-command-complete",
                         "destination":  "/api/broker-command-complete"
                     },
                     {
                         "source":  "/api/device-command-complete/:commandId",
                         "destination":  "/api/broker-command-complete"
                     },
                     {
                         "source":  "/api/device/enroll",
                         "destination":  "/api/device-enroll"
                     },
                     {
                         "source":  "/api/device/heartbeat",
                         "destination":  "/api/device-heartbeat"
                     },
                     {
                         "source":  "/api/device/commands/poll",
                         "destination":  "/api/device-commands-poll"
                     },
                     {
                         "source":  "/api/device/commands/:commandId/claim",
                         "destination":  "/api/broker-command-claim"
                     },
                     {
                         "source":  "/api/device/commands/:commandId/complete",
                         "destination":  "/api/broker-command-complete"
                     }
                 ],
    "crons":  [
                  {
                      "path":  "/api/check-stale",
                      "schedule":  "*/5 * * * *"
                  }
              ]
}
