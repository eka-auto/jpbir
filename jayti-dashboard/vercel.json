{
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/stats",
      "destination": "/api/stats.js"
    },
    {
      "source": "/api/visitor",
      "destination": "/api/visitor.js"
    },
    {
      "source": "/api/jp-stats",
      "destination": "/api/jp-stats.js"
    },
    {
      "source": "/api/jp-visitor",
      "destination": "/api/jp-visitor.js"
    },
    {
      "source": "/api/jp-track",
      "destination": "/api/jp-track.js"
    },
    {
      "source": "/api/jp-device",
      "destination": "/api/jp-device.js"
    },
    {
      "source": "/api/jp-agent",
      "destination": "/api/jp-agent.js"
    }
  ]
}
