[Unit]
Description=s24-mcp — streamable-HTTP MCP server for the Firestore device registry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jpagent
Group=jpagent
WorkingDirectory=/opt/s24-mcp
# S24_MCP_TOKEN and the Firestore/service settings live here, root-owned 0600,
# shared with jp-agent so both sides of the loopback call use one token.
EnvironmentFile=/etc/jp-agent.env
# ExecStart must name s24-mcp-server.mjs, the actual filename in /opt/s24-mcp.
# It previously said server.mjs, which never existed there.
ExecStart=/usr/bin/node /opt/s24-mcp/s24-mcp-server.mjs
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Same confinement as jp-agent.service. /opt/s24-mcp holds this unit's code and
# must stay writable for redeploys; nothing else on the filesystem does.
ReadWritePaths=/opt/s24-mcp
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=s24-mcp

[Install]
WantedBy=multi-user.target
