# channel-sandbox environment variables
#
# Set these on the Vercel project `channel-sandbox`
# (Settings → Environment Variables). Values in this file are placeholders —
# do NOT commit real values here.

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Dashboard-side key. Every route except /api/status and /api/diag requires it.
# Send as ?key=... or as an X-Stats-Key header. Any string works, but ASCII-only
# keeps hmac.compare_digest inputs simple (the current auth path SHA-256's both
# sides, so non-ASCII is also safe now). Use 64 hex chars: openssl rand -hex 32
#
# Store it on Vercel as type `sensitive`, and do NOT set it on the development
# environment. Vercel refuses to decrypt Secret values for production and preview,
# but `vercel env pull --environment=development` returns them in PLAINTEXT with no
# warning - so a development copy of the production key hands the live gate key to
# anyone holding project read access. That is exactly what happened here, and it
# only stopped mattering once the key was rotated. Development now has no
# STATS_KEY at all; `vercel dev` runs unauthenticated on loopback instead, and
# dashboard_api.py's main block refuses a non-loopback bind without one.
#
# Note /api/diag is deliberately unauthenticated and reports set/length for every
# variable below, so it discloses that this key exists and how long it is.
STATS_KEY=replace-me-with-a-long-random-string

# ─── FIRESTORE ───────────────────────────────────────────────────────────────
# Full sandbox config as a JSON string.
#
# `devices` and `allowed_commands` are NOT optional, and this example used to omit
# both - which is why provisioning from it did not work:
#
#   devices           A lambda has no devices.json. dashboard_api.py's own
#                     load_config_from_env docstring says so, and vercel.json's
#                     legacy `builds` entry never bundles it because nothing
#                     imports it. The roster therefore only ever arrives inside
#                     this variable. Without it, /api/devices,
#                     /api/devices/<id>/status, /api/data/<kind> and
#                     POST /api/devices/<id>/commands all answer 503 "server not
#                     configured". Before configured_devices() existed they raised
#                     a bare KeyError and Flask answered an HTML 500, which reads
#                     like a crash rather than a missing roster. The ids below are
#                     the tracked roster in devices.json - already public.
#
#   allowed_commands  Fails CLOSED: omit it and every POST is rejected 400, so the
#                     sandbox is read-only. Include it and those actions can be
#                     queued to a real device from a public endpoint gated only by
#                     STATS_KEY - note that start-ssh and start-daemon are in this
#                     list. Choose deliberately, and rotate STATS_KEY before
#                     enabling it if the key has ever been exposed.
#
# allow_production_devices must be true for mode=real with collection=devices,
# otherwise firestore_client.py refuses to build the client at all and every
# Firestore route 503s.
#
# The line below is byte-identical to channel-sandbox production: 675 chars,
# sha256 3a32b4623517... - cross-check against
# _shared/config/vercel-env.manifest.json before trusting either.
SANDBOX_CONFIG_JSON={"project":"intrepid-stage-495117-q1","database":"eka-agent","collection":"devices","firestore_scope":"https://www.googleapis.com/auth/datastore","mode":"real","allow_production_devices":true,"devices":[{"id":"samsung-s24-ultra","display_name":"Samsung S24 Ultra","role":"phone","type":"android","model":"SM-S928B"},{"id":"jayti-asus-vivobook","display_name":"Asus VivoBook","role":"laptop","type":"windows","model":"LENOVO"}],"allowed_commands":["sync-now","heartbeat","status-only","wakeup","collect-calls","collect-sms","collect-contacts","collect-location","collect-app-list","collect-whatsapp","full-sync","extract_whatsapp","debug-calllogs","start-ssh","start-daemon"]}

# Google service account credential as a JSON string. The service account needs
# roles/datastore.user on the Firestore database above. Get it from GCP
# Console → IAM & Admin → Service Accounts → Keys → "Add Key" → JSON.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ─── EXTERNAL AGENT (optional) ───────────────────────────────────────────────
# Only needed if you use /api/agent/query — the RAG proxy route. Otherwise
# that endpoint responds 503 "server missing AGENT_API_KEY" and every other
# route is unaffected.
# AGENT_API_URL=https://your-agent-host.example.com
# AGENT_API_KEY=replace-me

# ─── LOCAL-ONLY BYPASS (never set in production) ─────────────────────────────
# Setting this to any value disables the auth guard. Only for local emulator
# testing. Vercel MUST NOT have this set.
# SANDBOX_AUTH_DISABLED=1
