diff --git a/.github/workflows/dashboard-parity-check.yml b/.github/workflows/dashboard-parity-check.yml
index f7a1630..8a5aef6 100644
--- a/.github/workflows/dashboard-parity-check.yml
+++ b/.github/workflows/dashboard-parity-check.yml
@@ -64,6 +64,30 @@ jobs:
             }
           }
 
+          // Section: the property the dashboard actually opens on.
+          //
+          // Every check in this file names `jaytipargal.tech`, and that is why
+          // the outage the owner reported — no `jaytibirthday.in` rows reaching
+          // the warehouse from 2026-10-09 — passed a green parity run: the panel
+          // he was reading reads THIS property, and nothing asserted it had any
+          // data at all. A 7-day window with zero events is the incident
+          // signature, not a quiet week: the birthday site is the product, and
+          // the owner's own visits are its traffic.
+          const birthday = await getJson('/api/stats?days=7&site=jaytibirthday.in', authHeaders);
+          if (!birthday.res.ok || !birthday.json?.success) {
+            fail('Birthday property (/api/stats?site=jaytibirthday.in)', `HTTP ${birthday.res.status}`);
+          } else {
+            const bt = birthday.json.totals || {};
+            const bEvents = Number(bt.events_in_window || 0);
+            const bNewest = Array.isArray(birthday.json.latest_events) && birthday.json.latest_events[0]
+              ? (birthday.json.latest_events[0].receivedAt || 'no timestamp') : 'none';
+            if (bEvents === 0) {
+              fail('Birthday property ingestion', 'no events in the 7-day window — check the birthday tracker endpoint (the birthday project /api/track, not this project /api/jp-track) and the DynamoDB -> Neon repair at /api/db-push');
+            } else {
+              pass('Birthday property ingestion', `events=${bEvents}, sessions=${bt.unique_sessions}, active_now=${bt.active_now}, newest=${bNewest}`);
+            }
+          }
+
           // Section: Visitor drawer (/api/visitor), using first session from stats response
           let visitorOk = false;
           if (stats.json?.success && Array.isArray(stats.json.sessions) && stats.json.sessions.length > 0) {
@@ -138,12 +162,16 @@ jobs:
           if (!va.res.ok || va.json?.ok === false) fail('Vercel analytics section (/api/vercel-analytics)', `HTTP ${va.res.status}`);
           else pass('Vercel analytics section parity', 'ok');
 
-          // Backend cross-check anchor (same key gate as dashboard routes)
+          // Backend cross-check anchor (same key gate as dashboard routes).
+          // The freshness fields ride along here because this is the one caller
+          // that holds a key able to read them: newest_event_at is warehouse-wide
+          // and birthday_active_now is the birthday property in the last 120 s.
           const verify = await getJson('/api/verify-db', authHeaders);
           if (!verify.res.ok || verify.json?.success === false) {
             fail('Backend verify-db anchor', `HTTP ${verify.res.status}`);
           } else {
-            pass('Backend verify-db anchor', `tables=${verify.json?.databases?.postgres?.tables_present ?? 'n/a'}`);
+            const pg = verify.json?.databases?.postgres || {};
+            pass('Backend verify-db anchor', `tables=${pg.tables_present ?? 'n/a'}, newest_event_at=${pg.newest_event_at ?? 'n/a'}, birthday_active_now=${pg.birthday_active_now ?? 'n/a'}`);
           }
 
           const failed = checks.filter(c => !c.ok);
