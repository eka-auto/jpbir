-# Sole ingress to jp-agent. The Node service binds 127.0.0.1 only, so this is
-# the one path in — which is what makes the bearer check unbypassable.
-#
-# TLS is added afterwards by certbot (see README). Until then this serves plain
-# HTTP, which is acceptable ONLY because the caller is Vercel over the public
-# internet with a bearer token; run certbot before treating it as production.
-#
-# STATUS: certbot HAS been run on the droplet (2026-09-12, cert for
-# runner.jaytipargal.tech valid to 2026-12-11), so the LIVE vhost no longer
-# matches this file — certbot moved :80 to a redirect-or-404 block and added the
-# :443 listener. This file is the pre-TLS template only. deploy.sh detects the
-# certbot markers and will not overwrite the live copy.
-
-upstream jp_agent {
-    server 127.0.0.1:8790;
-    keepalive 8;
-}
-
-server {
-    listen 80;
-    listen [::]:80;
-    server_name runner.jaytipargal.tech;
-
-    # The agent is not a browser app. No CORS headers on purpose: the only
-    # legitimate caller is the Vercel function, server-to-server. A browser
-    # that finds this endpoint should get nowhere even holding the token.
-    add_header X-Content-Type-Options nosniff always;
-    add_header X-Frame-Options DENY always;
-
-    client_max_body_size 8m;
-
-    location /health {
-        proxy_pass http://jp_agent;
-        access_log off;
-    }
-
-    location / {
-        proxy_pass http://jp_agent;
-        proxy_http_version 1.1;
-        proxy_set_header Host $host;
-        proxy_set_header X-Real-IP $remote_addr;
-        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
-        proxy_set_header Connection "";
-
-        # Server-Sent Events: buffering here would hold the whole response
-        # until completion and defeat the point of streaming progress.
-        proxy_buffering off;
-        proxy_cache off;
-
-        # An agent task can legitimately run for minutes (installs, builds,
-        # test suites). Default 60s timeouts would sever those mid-run.
-        proxy_read_timeout 900s;
-        proxy_send_timeout 900s;
-    }
-}
