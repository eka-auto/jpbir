{
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "functions": {
    "api/track.js": {
      "includeFiles": "Database/data/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*).(mp4|webm|jpg|jpeg|png|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/js/jaytibirthday-analytics.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/db-admin",
      "destination": "/api/db-admin.js"
    },
    {
      "source": "/api/galaxy",
      "destination": "/api/galaxy.js"
    },
    {
      "source": "/api/wa-ingest",
      "destination": "/api/wa-ingest.js"
    },
    {
      "source": "/api/story-unlock",
      "destination": "/api/story-unlock.js"
    },
    {
      "source": "/api/track",
      "destination": "/api/track.js"
    },
    {
      "source": "/api/video-event",
      "destination": "/api/video-event.js"
    },
    {
      "source": "/api/letter",
      "destination": "/api/letter.js"
    },
    {
      "source": "/api/mcp-auth",
      "destination": "/api/mcp-auth.js"
    },
    {
      "source": "/api/mcp-connect",
      "destination": "/api/mcp-connect.js"
    },
    {
      "source": "/api/mcp-lookup",
      "destination": "/api/mcp-lookup.js"
    },
    {
      "source": "/api/mcp",
      "destination": "/api/mcp.js"
    },
    {
      "source": "/",
      "destination": "/Frontend"
    },
    {
      "source": "/letter",
      "destination": "/Frontend/letter"
    },
    {
      "source": "/chat-galaxy",
      "destination": "/Frontend/chat-galaxy"
    },
    {
      "source": "/jteka",
      "destination": "/Frontend/jteka.html"
    },
    {
      "source": "/cards_data.json",
      "destination": "/Frontend/cards_data.json"
    },
    {
      "source": "/cards_secret.json",
      "destination": "/Frontend/cards_secret.json"
    },
    {
      "source": "/robots.txt",
      "destination": "/Frontend/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/Frontend/sitemap.xml"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/Frontend/assets/$1"
    }
  ]
}
