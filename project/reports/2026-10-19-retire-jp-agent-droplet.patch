From 996f7256493aa270dcdcfe4dc96d2715d12932e6 Mon Sep 17 00:00:00 2001
From: "cline-cloud[bot]" <cline-cloud[bot]@users.noreply.github.com>
Date: Mon, 19 Oct 2026 01:21:14 +0000
Subject: [PATCH] ci(render): rename the jp-agent job and retire its droplet
 rationale

---
 .github/workflows/ci-cd.yml | 21 +++++++++++----------
 1 file changed, 11 insertions(+), 10 deletions(-)

diff --git a/.github/workflows/ci-cd.yml b/.github/workflows/ci-cd.yml
index 940cdf0..39ffa7a 100644
--- a/.github/workflows/ci-cd.yml
+++ b/.github/workflows/ci-cd.yml
@@ -87,18 +87,19 @@ jobs:
           docker run --rm -v "$PWD:/repo" --workdir /repo \
             rhysd/actionlint:1.7.12 -color -verbose
 
-  # Server/jp-agent is the droplet runtime and has its own package.json, so neither `npm ci`
-  # nor `npm test` above ever touched it. Its tests existed and passed by hand, but nothing
-  # ran them - so two fixes to device-health.mjs on 2026-09-19 (0637de9, 9040523) went in
-  # with CI green that meant nothing for the droplet.
+  # Server/jp-agent is its own package.json, so neither `npm ci` nor `npm test` above ever
+  # touched it. Its tests existed and passed by hand, but nothing ran them - so two fixes to
+  # device-health.mjs on 2026-09-19 (0637de9, 9040523) went in with CI green that meant
+  # nothing for the runtime.
   #
-  # The droplet is deployed by hand (deploy.sh), and a mistake there cannot be rolled back
-  # from here, so the last step checks the failure a refactor is most likely to cause: the
-  # service dying at start with ERR_MODULE_NOT_FOUND. Importing s24-tools.mjs resolves
-  # everything server.mjs imports (s24-tools -> device-health -> s24-attestation).
-  # server.mjs itself calls listen() at import, so it only gets a syntax check.
+  # The runtime is the Render web service jp-agent (render.yaml, project/targets.json), which
+  # deploys from git and cannot be rolled back from here, so the last step checks the failure
+  # a refactor is most likely to cause: the service dying at start with ERR_MODULE_NOT_FOUND.
+  # Importing s24-tools.mjs resolves everything server.mjs imports (s24-tools ->
+  # device-health -> s24-attestation). server.mjs itself calls listen() at import, so it only
+  # gets a syntax check.
   jp-agent:
-    name: jp-agent (droplet) tests
+    name: jp-agent tests
     runs-on: ubuntu-latest
     defaults:
       run:
-- 
