{
  "version": 2,
  "builds": [
    {
      "src": "app/backend/broker-command-claim.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/broker-command-complete.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/check-stale.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/connect.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/device-commands-poll.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/device-enroll.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/device-heartbeat.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/jp-agent.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/jp-ask.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/jp-debug.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/jp-device.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/jp-devices.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/jp-live-agent.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/jp-stats.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/jp-track.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/jp-visitor.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/stats.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/visitor.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/backend/verify-db.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/device-command-claim",
      "dest": "app/backend/broker-command-claim.js"
    },
    {
      "src": "/api/device-command-claim/(?<commandId>[^/]+)",
      "dest": "app/backend/broker-command-claim.js?commandId=$commandId"
    },
    {
      "src": "/api/device-command-complete",
      "dest": "app/backend/broker-command-complete.js"
    },
    {
      "src": "/api/device-command-complete/(?<commandId>[^/]+)",
      "dest": "app/backend/broker-command-complete.js?commandId=$commandId"
    },
    {
      "src": "/api/(.*)(.js)?",
      "dest": "app/backend/$1.js"
    },
    {
      "src": "/s24",
      "dest": "/app/frontend/s24.html"
    },
    {
      "src": "/vivobook",
      "dest": "/app/frontend/vivobook.html"
    },
    {
      "src": "/(.*)",
      "dest": "/app/frontend/$1"
    }
  ],
  "outputDirectory": "app/frontend"
}
