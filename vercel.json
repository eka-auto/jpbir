{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/check-stale",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/db-push",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/s24-sync-cron",
      "schedule": "17 */6 * * *"
    },
    {
      "path": "/api/stack-cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/dashboard-sync",
      "schedule": "*/15 * * * *"
    }
  ],
  "builds": [
    {
      "src": "Backend/broker-command-claim.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/broker-command-complete.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/check-stale.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/connect.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/device-commands-poll.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/device-enroll.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/device-heartbeat.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-agent.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/s24-command.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-debug.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-devices.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/s24-public.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-live-agent.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-hub-state.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-live-content.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-stack.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-stats.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-track.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/track.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-visitor.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/stack-cron.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/stats.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/visitor.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/verify-db.js",
      "use": "@vercel/node"
    },
    {
      "src": "Frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "Backend/vercel-analytics.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/db-api.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/db-push.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-whatsapp.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-wa-chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/wa-galaxy.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/wa-chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/wa-ingest.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/s24-ingest.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/wa-blob-upload.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-wa-attachments.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-wa-messages.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/wa-media.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/s24-sync-cron.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-device.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/dashboard-sections.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/dashboard-sync.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-telegram.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/s24-ultra.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/device-dashboard.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/s24-whatsapp.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/s24-media.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/s24-telegram.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/s24-live.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/s24-group.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/vivobook.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/vivobook-group.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
        "Referrer-Policy": "no-referrer",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "/api/wa-media",
      "headers": {
        "Content-Security-Policy": "frame-ancestors 'self'; object-src 'none'; base-uri 'none'",
        "X-Frame-Options": "SAMEORIGIN"
      },
      "dest": "Backend/wa-media.js"
    },
    {
      "src": "/agent",
      "dest": "/Frontend/agent.html"
    },
    {
      "src": "/agent/query",
      "dest": "Backend/jp-live-agent.js"
    },
    {
      "src": "/agent/health",
      "dest": "Backend/jp-live-agent.js?op=health"
    },
    {
      "src": "/agent/state",
      "dest": "Backend/jp-hub-state.js"
    },
    {
      "src": "/api/vercel-analytics",
      "dest": "Backend/vercel-analytics.js"
    },
    {
      "src": "/api/device-command-claim",
      "dest": "Backend/broker-command-claim.js"
    },
    {
      "src": "/api/device-command-claim/(?<commandId>[^/]+)",
      "dest": "Backend/broker-command-claim.js?commandId=$commandId"
    },
    {
      "src": "/api/device-command-complete",
      "dest": "Backend/broker-command-complete.js"
    },
    {
      "src": "/api/device-command-complete/(?<commandId>[^/]+)",
      "dest": "Backend/broker-command-complete.js?commandId=$commandId"
    },
    {
      "src": "/api/s24-command",
      "dest": "Backend/s24-command.js"
    },
    {
      "src": "/api/s24-sync-cron",
      "dest": "Backend/s24-sync-cron.js"
    },
    {
      "src": "/api/jp-device",
      "dest": "Backend/jp-device.js"
    },
    {
      "src": "/api/stack-cron",
      "dest": "Backend/stack-cron.js"
    },
    {
      "src": "/api/jp-stack",
      "dest": "Backend/jp-stack.js"
    },
    {
      "src": "/api/jp-devices",
      "dest": "Backend/jp-devices.js"
    },
    {
      "src": "/api/s24-public",
      "dest": "Backend/s24-public.js"
    },
    {
      "src": "/api/(.*)(.js)?",
      "dest": "Backend/$1.js"
    },
    {
      "src": "/db",
      "dest": "/Frontend/db.html"
    },
    {
      "src": "/s24",
      "dest": "/Frontend/s24.html"
    },
    {
      "src": "/vivobook",
      "dest": "/Frontend/vivobook.html"
    },
    {
      "src": "/jteka",
      "dest": "/Frontend/jteka.html"
    },
    {
      "src": "/viewer",
      "dest": "/Frontend/viewer.html"
    },
    {
      "src": "/(.*)",
      "dest": "/Frontend/$1"
    }
  ],
  "outputDirectory": "Frontend"
}
