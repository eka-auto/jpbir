# Environment variables required by jayti-dashboard
# Copy this file to .env.local and fill in real values; never commit secrets.

# Vercel Connect OAuth client ID for the red-marble connector
CONNECT_CLIENT_ID=

# Vercel Connect connector UID (e.g. vercel/red-marble)
CONNECT_CONNECTOR_UID=vercel/red-marble

# Shared admin/auth key for dashboard and API routes
STATS_KEY=
AGENT_API_URL=http://127.0.0.1:8000
AGENT_API_KEY=

# AWS credentials for DynamoDB telemetry
JP_AWS_ACCESS_KEY_ID=
JP_AWS_SECRET_ACCESS_KEY=
JP_WRITE_AWS_ACCESS_KEY_ID=
JP_WRITE_AWS_SECRET_ACCESS_KEY=
JP_AWS_REGION=us-west-2

# Vercel Blob token for older visitor records
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
