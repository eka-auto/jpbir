{
  "version": 2,
  "builds": [
    {
      "src": "Backend/broker-command-claim.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/broker-command-complete.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/check-stale.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/connect.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/device-commands-poll.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/device-enroll.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/device-heartbeat.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-agent.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/s24-command.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-debug.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-device.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-devices.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-live-agent.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-live-content.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-stats.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-track.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-visitor.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/stats.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/visitor.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/verify-db.js",
      "use": "@vercel/node"
    },
    {
      "src": "Frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "Backend/vercel-analytics.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/agent-run.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/db-push.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/db-api.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-whatsapp.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-wa-chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/wa-galaxy.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/wa-chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/wa-ingest.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/s24-ingest.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/wa-blob-upload.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-wa-attachments.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/jp-wa-messages.js",
      "use": "@vercel/node"
    },
    {
      "src": "Backend/wa-media.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/agent-run",
      "dest": "Backend/agent-run.js"
    },
    {
      "src": "/api/vercel-analytics",
      "dest": "Backend/vercel-analytics.js"
    },
    {
      "src": "/api/device-command-claim",
      "dest": "Backend/broker-command-claim.js"
    },
    {
      "src": "/api/device-command-claim/(?<commandId>[^/]+)",
      "dest": "Backend/broker-command-claim.js?commandId=$commandId"
    },
    {
      "src": "/api/device-command-complete",
      "dest": "Backend/broker-command-complete.js"
    },
    {
      "src": "/api/device-command-complete/(?<commandId>[^/]+)",
      "dest": "Backend/broker-command-complete.js?commandId=$commandId"
    },
    {
      "src": "/api/s24-command",
      "dest": "Backend/s24-command.js"
    },
    {
      "src": "/api/(.*)(.js)?",
      "dest": "Backend/$1.js"
    },
    {
      "src": "/db",
      "dest": "/Frontend/db.html"
    },
    {
      "src": "/s24",
      "dest": "/Frontend/s24.html"
    },
    {
      "src": "/vivobook",
      "dest": "/Frontend/vivobook.html"
    },
    {
      "src": "/jteka",
      "dest": "/Frontend/jteka.html"
    },
    {
      "src": "/(.*)",
      "dest": "/Frontend/$1"
    }
  ],
  "outputDirectory": "Frontend"
}
