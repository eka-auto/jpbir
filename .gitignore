clone-lab/

# Per-machine agent and editor tooling. None of it is part of the app, and all of it was
# untracked AND unignored, so a single `git add -A` would have committed it — 84 files on
# 2026-09-19. .agents/ holds third-party skills installed by `npx skills` (3.7 MB, recorded
# in skills-lock.json); .qwen/ is Qwen Code's settings, symlinks into .agents/ and its
# session scratch; .vscode/ is personal editor and MCP config. Tracked agent skills that
# belong to the project live under .claude/skills/ instead.
.agents/
.qwen/
.vscode/
skills-lock.json

# Git worktree artifacts (committed by mistake during restructure)
_shared/.git__1
_shared/.gitkeep
_shared/.gitmodules
_shared/.gitignore

# IDE configs accidentally committed (Kiro, Claude, VS Code)
_shared/.config.kiro
_shared/.claudesignore
_shared/.vscodeignore
_shared/.vercelignore

# Vercel local link artifacts
_shared/.vercel/

# Generated audit/inventory reports
_shared/reports/

# Local browser-profile extraction workspaces: these carry cookies and session
# tokens. Two such SQLite databases reached this repository's history and are
# still fetchable from it (project/reports/2026-10-17-history-secret-scan-and-licence-inventory.md).
chrome_extraction/

# Accidentally committed project metadata and configs
_shared/frontend-assembly.patch
_shared/reg.tmLanguage
_shared/locale.properties
_shared/package-lock.json
_shared/pyproject.toml
_shared/vite.config.ts
_shared/LICENSE
_shared/LICENSE_FOXIT
_shared/LICENSE_LIBERATION
_shared/package.json

# Claude Code hooks and settings (not .local.json)
.claude/hooks/
.claude/settings.json

# Per-machine agent tooling. .claude/settings.local.json is already ignored
# above; .kilo/ is the same class -- another assistant's local workspace state,
# untracked but NOT ignored, so one `git add -A` sweeps it into a commit.
# .vercelignore already fences both out of a CLI deploy.
.kilo/

# Pre-restructure residue, and the same hazard one level up: untracked but NOT
# ignored, so one `git add -A` commits 84 files -- among them a live GCP
# service-account private key
# (firebase-adminsdk-fbsvc-intrep@intrepid-stage-495117-q1, kid f57ce7f23f91...),
# secrets.json / secret_scan.json / secrets-scrub.json, password-, cookie- and
# login-metadata dumps, hf_bucket_credential_audit.json, and eight _tmp_*.mjs
# one-off scripts. Nothing under app/ is tracked at HEAD; it is leftover from
# before the five-layer restructure. .vercelignore already fences app/ out of a
# `vercel --prod` upload -- this is the git-side guard on the same tree.
/app/

# Service-account keys anywhere in the tree, not just under app/. Named for the
# GCP project and for the two conventional credential filenames, so a key dropped
# next to the code it serves is still caught. No tracked file matches these.
intrepid-stage-*.json
*serviceAccountKey*.json
*service_account*.json

# Local sysroot used to run the browser suite on a machine without root
# (see project/reports/2026-10-19-e2e-unblocked.md). Never committed.
.chromium-deps/
